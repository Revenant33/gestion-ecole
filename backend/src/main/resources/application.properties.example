spring.application.name=gestion-ecole
spring.datasource.url=jdbc:mysql://localhost:3306/gestion_ecole?useSSL=false&serverTimezone=UTC
spring.datasource.username=root
spring.datasource.password=YOUR_MYSQL_PASSWORD
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
server.port=8080
app.jwt.secret=CHANGE_ME_use_a_long_random_string_of_at_least_32_characters
app.jwt.expiration-ms=86400000